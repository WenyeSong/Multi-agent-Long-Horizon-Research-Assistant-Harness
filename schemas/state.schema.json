{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-agent-hackathon/state.schema.json",
  "title": "PlannerState",
  "description": "Canonical finite-state record owned by the OpenClaw main planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "phase",
    "compliance_mode",
    "github_repository",
    "review_cycle",
    "problem",
    "completed",
    "artifacts",
    "allowed_next_actions"
  ],
  "properties": {
    "trace_id": {
      "description": "Use the active OpenClaw session name or session id so the workspace path is projects/<session_name>/.",
      "$ref": "#/$defs/trace_id"
    },
    "phase": {
      "type": "string",
      "enum": [
        "S0_intake",
        "S1_problem_analysis",
        "S2_lit_review",
        "S3_lit_synthesis",
        "S4_execution_plan",
        "S5_execution",
        "S6_review",
        "S7_revise",
        "S8_pdf_generate",
        "S9_final"
      ]
    },
    "compliance_mode": { "$ref": "#/$defs/compliance_mode" },
    "github_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "status", "visibility", "sync_policy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["not_requested", "planned", "linked", "created", "syncing", "disabled"]
        },
        "visibility": { "type": "string", "enum": ["private", "public"] },
        "sync_policy": {
          "type": "string",
          "enum": ["off", "manual", "user_requested", "progress_milestones"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "remote_name": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 },
        "current_branch": { "type": "string", "minLength": 1 },
        "html_url": { "type": "string", "format": "uri" },
        "last_sync_at": { "type": "string", "format": "date-time" },
        "maintenance_log": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "at", "summary"],
            "properties": {
              "action": {
                "type": "string",
                "enum": ["created_repo", "linked_remote", "committed", "pushed", "opened_issue", "opened_pr", "updated_metadata"]
              },
              "at": { "type": "string", "format": "date-time" },
              "ref": { "type": "string" },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "review_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_round", "max_rounds", "force_pass_on_max_round", "forced_pass_used"],
      "properties": {
        "current_round": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_rounds": { "const": 5 },
        "force_pass_on_max_round": { "const": true },
        "forced_pass_used": { "type": "boolean" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["round", "verdict", "review_result"],
            "properties": {
              "round": { "type": "integer", "minimum": 1, "maximum": 5 },
              "verdict": { "type": "string", "enum": ["PASS", "REVISE", "BLOCK"] },
              "forced_pass": { "type": "boolean" },
              "review_result": { "$ref": "#/$defs/artifact_ref" }
            }
          }
        }
      }
    },
    "role_orchestration": {
      "type": "object",
      "description": "Planner-owned checklist proving which worker roles are required and how many times each has run for this trace.",
      "additionalProperties": false,
      "required": [
        "pipeline_mode",
        "required_roles",
        "invocation_counts",
        "all_required_roles_invoked",
        "minimum_report_pipeline_completed"
      ],
      "properties": {
        "pipeline_mode": {
          "type": "string",
          "enum": ["source_only", "full_report"]
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/worker_agent" }
        },
        "invocation_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literature_reviewer",
            "executor",
            "reviewer",
            "pdf_generator"
          ],
          "properties": {
            "literature_reviewer": { "type": "integer", "minimum": 0 },
            "executor": { "type": "integer", "minimum": 0 },
            "reviewer": { "type": "integer", "minimum": 0 },
            "pdf_generator": { "type": "integer", "minimum": 0 }
          }
        },
        "all_required_roles_invoked": { "type": "boolean" },
        "minimum_report_pipeline_completed": {
          "type": "boolean",
          "description": "True only after every required role for this pipeline mode has run in the current trace and report gating rules have been satisfied."
        },
        "last_missing_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/worker_agent" },
          "uniqueItems": true
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "project_id", "research_goal", "summary"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "research_goal": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "assessment_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_coursework"],
          "properties": {
            "is_coursework": { "type": "boolean" },
            "source_policy_refs": {
              "type": "array",
              "items": { "$ref": "#/$defs/artifact_ref" }
            },
            "marking_weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "program_runs_and_figures": { "type": "number", "minimum": 0, "maximum": 1 },
                "mathematical_answers_and_observations": { "type": "number", "minimum": 0, "maximum": 1 },
                "report_clarity": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_analysis",
        "literature_review",
        "lit_synthesis",
        "execution_plan",
        "execution",
        "review",
        "pdf"
      ],
      "properties": {
        "problem_analysis": { "type": "boolean" },
        "literature_review": { "type": "boolean" },
        "lit_synthesis": { "type": "boolean" },
        "execution_plan": { "type": "boolean" },
        "execution": { "type": "boolean" },
        "review": { "type": "boolean" },
        "pdf": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_request": { "$ref": "#/$defs/artifact_ref" },
        "problem_materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_id", "path", "allowed_use"],
            "properties": {
              "material_id": { "type": "string", "minLength": 1 },
              "path": { "$ref": "#/$defs/artifact_ref" },
              "allowed_use": { "type": "string", "minLength": 1 }
            }
          }
        },
        "plan": { "$ref": "#/$defs/artifact_ref" },
        "literature_result": { "$ref": "#/$defs/artifact_ref" },
        "method_matrix": { "$ref": "#/$defs/artifact_ref" },
        "literature_synthesis": { "$ref": "#/$defs/artifact_ref" },
        "execution_plan": { "$ref": "#/$defs/artifact_ref" },
        "execution_result": { "$ref": "#/$defs/artifact_ref" },
        "figures_dir": { "$ref": "#/$defs/artifact_ref" },
        "review_result": { "$ref": "#/$defs/artifact_ref" },
        "approved_content": { "$ref": "#/$defs/artifact_ref" },
        "report_spec": { "$ref": "#/$defs/artifact_ref" },
        "agent_trace": { "$ref": "#/$defs/artifact_ref" },
        "agent_trace_summary": { "$ref": "#/$defs/artifact_ref" },
        "final_pdf": { "$ref": "#/$defs/artifact_ref" },
        "final_html": { "$ref": "#/$defs/artifact_ref" },
        "final_report": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "agent_trace": {
      "type": "array",
      "description": "Concise planner-owned trace of worker role invocations and routing context.",
      "items": { "$ref": "#/$defs/agent_trace_entry" }
    },
    "last_worker_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "artifact_ref", "received_at"],
      "properties": {
        "agent": {
          "type": "string",
          "enum": [
            "literature_reviewer",
            "executor",
            "reviewer",
            "pdf_generator"
          ]
        },
        "status": { "type": "string" },
        "artifact_ref": { "$ref": "#/$defs/artifact_ref" },
        "received_at": { "type": "string", "format": "date-time" }
      }
    },
    "allowed_next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "S8_pdf_generate" } } },
      "then": {
        "properties": {
          "completed": {
            "properties": {
              "review": { "const": true }
            }
          },
          "artifacts": {
            "required": ["review_result", "report_spec"]
          },
          "allowed_next_actions": {
            "items": {
              "enum": ["spawn_pdf_generator", "block_for_human"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "S9_final" } } },
      "then": {
        "properties": {
          "role_orchestration": {
            "required": ["all_required_roles_invoked", "minimum_report_pipeline_completed"],
            "properties": {
              "all_required_roles_invoked": { "const": true },
              "minimum_report_pipeline_completed": { "const": true }
            }
          },
          "allowed_next_actions": {
            "items": {
              "enum": ["return_final", "block_for_human"]
            }
          }
        },
        "required": ["role_orchestration"]
      }
    }
  ],
  "$defs": {
    "trace_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{2,127}$"
    },
    "compliance_mode": {
      "type": "string",
      "enum": ["study_assistant", "independent_research"],
      "default": "study_assistant"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(projects/|/projects/|\\./projects/).+"
    },
    "worker_agent": {
      "type": "string",
      "enum": [
        "literature_reviewer",
        "executor",
        "reviewer",
        "pdf_generator"
      ]
    },
    "agent_trace_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_event_id",
        "agent",
        "phase",
        "action",
        "status",
        "reason",
        "input_context_summary",
        "output_summary"
      ],
      "properties": {
        "trace_event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{3,128}$"
        },
        "agent": { "$ref": "#/$defs/worker_agent" },
        "phase": {
          "type": "string",
          "enum": [
            "S0_intake",
            "S1_problem_analysis",
            "S2_lit_review",
            "S3_lit_synthesis",
            "S4_execution_plan",
            "S5_execution",
            "S6_review",
            "S7_revise",
            "S8_pdf_generate",
            "S9_final"
          ]
        },
        "action": { "$ref": "#/$defs/action" },
        "status": {
          "type": "string",
          "enum": ["planned", "running", "ok", "revised", "blocked", "failed", "skipped"]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "input_context_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "input_artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "output_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "output_artifact_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "spawn_literature_reviewer",
        "synthesize_literature",
        "write_execution_plan",
        "spawn_executor",
        "spawn_reviewer",
        "revise_literature",
        "revise_execution",
        "revise_pdf",
        "force_reviewer_pass",
        "maintain_github_repository",
        "spawn_pdf_generator",
        "block_for_human",
        "return_final"
      ]
    }
  }
}

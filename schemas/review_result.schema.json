{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-agent-hackathon/review_result.schema.json",
  "title": "ReviewResult",
  "description": "Reviewer gate result. Only PASS permits report_spec/pdf generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "review_round",
    "verdict",
    "reviewed_artifact_refs",
    "blocking_issues",
    "non_blocking_issues",
    "pass_checks",
    "compliance_risk",
    "round_limit",
    "next_action"
  ],
  "properties": {
    "trace_id": { "$ref": "#/$defs/trace_id" },
    "review_round": { "type": "integer", "minimum": 1, "maximum": 5 },
    "verdict": { "type": "string", "enum": ["PASS", "REVISE", "BLOCK"] },
    "reviewed_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "blocking_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_issue_with_target" }
    },
    "non_blocking_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_issue" }
    },
    "pass_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citations_traceable",
        "ten_papers_summarized_without_obvious_hallucination",
        "math_matches_problem",
        "results_reproducible",
        "figures_labeled",
        "code_text_consistent",
        "not_packaged_as_student_submission",
        "pdf_adds_no_unreviewed_claims"
      ],
      "properties": {
        "citations_traceable": { "type": "boolean" },
        "ten_papers_summarized_without_obvious_hallucination": { "type": "boolean" },
        "math_matches_problem": { "type": "boolean" },
        "results_reproducible": { "type": "boolean" },
        "figures_labeled": { "type": "boolean" },
        "code_text_consistent": { "type": "boolean" },
        "not_packaged_as_student_submission": { "type": "boolean" },
        "pdf_adds_no_unreviewed_claims": { "type": "boolean" }
      }
    },
    "compliance_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reason"],
      "properties": {
        "level": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "round_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "round_reached",
        "forced_pass",
        "unresolved_issues_summary"
      ],
      "properties": {
        "max_rounds": { "const": 5 },
        "round_reached": { "type": "integer", "minimum": 1, "maximum": 5 },
        "forced_pass": { "type": "boolean" },
        "status_message": { "type": "string" },
        "unresolved_issues_summary": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_issue_with_target" }
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["return_to_planner", "block_for_human"]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["verdict", "round_limit"],
        "properties": {
          "verdict": { "const": "PASS" },
          "round_limit": {
            "required": ["forced_pass"],
            "properties": {
              "forced_pass": { "const": false }
            }
          }
        }
      },
      "then": {
        "properties": {
          "blocking_issues": { "maxItems": 0 },
          "next_action": { "const": "return_to_planner" },
          "pass_checks": {
            "properties": {
              "citations_traceable": { "const": true },
              "ten_papers_summarized_without_obvious_hallucination": { "const": true },
              "math_matches_problem": { "const": true },
              "results_reproducible": { "const": true },
              "figures_labeled": { "const": true },
              "code_text_consistent": { "const": true },
              "not_packaged_as_student_submission": { "const": true },
              "pdf_adds_no_unreviewed_claims": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["verdict", "round_limit"],
        "properties": {
          "verdict": { "const": "PASS" },
          "round_limit": {
            "required": ["forced_pass"],
            "properties": {
              "forced_pass": { "const": true }
            }
          }
        }
      },
      "then": {
        "properties": {
          "blocking_issues": { "maxItems": 0 },
          "next_action": { "const": "return_to_planner" },
          "round_limit": {
            "properties": {
              "max_rounds": { "const": 5 },
              "round_reached": { "const": 5 },
              "forced_pass": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "BLOCK" } } },
      "then": {
        "properties": {
          "next_action": { "const": "block_for_human" }
        }
      }
    }
  ],
  "$defs": {
    "trace_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{2,127}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(projects/|/projects/|\\./projects/).+"
    },
    "review_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "math_correctness",
            "literature_traceability",
            "evidence_quality",
            "reproducibility",
            "figure_quality",
            "consistency",
            "compliance",
            "presentation"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "review_issue_with_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "message", "send_back_to"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "math_correctness",
            "literature_traceability",
            "evidence_quality",
            "reproducibility",
            "figure_quality",
            "consistency",
            "compliance",
            "presentation"
          ]
        },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "message": { "type": "string", "minLength": 1 },
        "send_back_to": {
          "type": "string",
          "enum": [
            "planner",
            "literature_reviewer",
            "executor",
            "pdf_generator",
            "human"
          ]
        }
      }
    }
  }
}

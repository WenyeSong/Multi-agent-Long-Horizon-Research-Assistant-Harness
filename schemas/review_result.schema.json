{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-agent-hackathon/review_result.schema.json",
  "title": "ReviewResult",
  "description": "Reviewer judgment before PDF generation. The LLM makes the review decision; scripts provide preflight, provenance, optional verification, and scope evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "state_version",
    "decision",
    "confidence",
    "route_suggestion",
    "summary",
    "blocking_issues",
    "major_issues",
    "advisory_notes",
    "checked_artifacts",
    "requirement_map_summary",
    "verification",
    "scope_audit",
    "pass_token_issued"
  ],
  "properties": {
    "task_id": { "$ref": "#/$defs/id" },
    "trace_id": { "$ref": "#/$defs/id" },
    "review_id": { "$ref": "#/$defs/id" },
    "generated_at": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": "string", "minLength": 1 },
    "state_version": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["PASS", "REVISE", "REPLAN", "BLOCK", "INCONCLUSIVE"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "route_suggestion": {
      "type": "string",
      "enum": [
        "planner",
        "literature_reviewer",
        "executor",
        "main",
        "pdf_generator",
        "none"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "blocking_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "major_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "advisory_notes": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "checked_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/checked_artifact" }
    },
    "requirement_map_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_required_checked",
        "implied_required_checked",
        "optional_not_blocking"
      ],
      "properties": {
        "explicit_required_checked": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "implied_required_checked": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "optional_not_blocking": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ran_commands", "status", "notes"],
      "properties": {
        "ran_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command_result" }
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "not_run", "partial"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["clean", "warning", "violation"]
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pass_token_issued": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "PASS" } } },
      "then": {
        "properties": {
          "blocking_issues": { "maxItems": 0 },
          "route_suggestion": { "const": "none" },
          "pass_token_issued": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "BLOCK" } } },
      "then": {
        "properties": {
          "route_suggestion": { "enum": ["main", "planner"] }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "REPLAN" } } },
      "then": {
        "properties": {
          "route_suggestion": { "const": "planner" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{2,127}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "checked_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/artifact_ref" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "role": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "owner",
        "evidence",
        "reason",
        "recommended_fix"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["blocking", "major", "advisory"]
        },
        "owner": {
          "type": "string",
          "enum": [
            "planner",
            "literature_reviewer",
            "executor",
            "main",
            "pdf_generator"
          ]
        },
        "evidence": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "recommended_fix": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "status"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "timeout", "skipped"]
        },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_tail": { "type": "string" },
        "stderr_tail": { "type": "string" }
      }
    }
  }
}

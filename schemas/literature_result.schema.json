{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/multi-agent-hackathon/literature_result.schema.json",
  "title": "LiteratureReviewResult",
  "description": "Structured result returned by literature_reviewer to research-planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "status",
    "selected_papers",
    "theme_analysis",
    "risks",
    "artifact_refs"
  ],
  "properties": {
    "trace_id": { "$ref": "#/$defs/trace_id" },
    "status": { "type": "string", "enum": ["ok", "partial", "blocked"] },
    "selected_papers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/paper" }
    },
    "theme_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themes", "method_families"],
      "properties": {
        "themes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "method_families": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_ref" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": {
        "properties": {
          "selected_papers": { "minItems": 10, "maxItems": 10 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } } },
      "then": {
        "properties": {
          "selected_papers": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "trace_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{2,127}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(projects/|/projects/|\\./projects/).+"
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "year",
        "venue",
        "doi_or_arxiv",
        "url",
        "relevance_score",
        "method_summary",
        "key_equations",
        "assumptions",
        "limitations",
        "connection_to_problem",
        "source_confidence"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "year": { "type": "integer", "minimum": 1800 },
        "venue": { "type": "string" },
        "doi_or_arxiv": { "type": "string" },
        "url": { "type": "string", "minLength": 1 },
        "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "method_summary": { "type": "string", "minLength": 1 },
        "key_equations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "connection_to_problem": { "type": "string", "minLength": 1 },
        "source_confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    }
  }
}

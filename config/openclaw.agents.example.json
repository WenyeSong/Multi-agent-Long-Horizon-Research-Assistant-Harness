{
  "agents": {
    "defaults": {
      "subagents": {
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 4,
        "maxConcurrent": 4,
        "runTimeoutSeconds": 900
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Research UI",
        "workspace": "~/.openclaw/workspace-main",
        "tools": {
          "allow": ["read", "write", "sessions_spawn", "sessions_history", "session_status"],
          "deny": ["exec", "apply_patch", "external_post"]
        }
      },
      {
        "id": "research-planner",
        "name": "Research Planner",
        "workspace": "~/.openclaw/workspace-research",
        "sandbox": { "mode": "all", "scope": "agent" },
        "tools": {
          "allow": ["read", "write", "sessions_spawn", "sessions_history", "session_status"],
          "deny": ["exec", "browser", "external_post"]
        }
      },
      {
        "id": "literature-reviewer",
        "name": "Literature Reviewer",
        "workspace": "~/.openclaw/workspace-literature",
        "sandbox": { "mode": "all", "scope": "agent" },
        "tools": {
          "allow": ["read", "write", "browser"],
          "deny": ["exec", "sessions_spawn", "apply_patch", "external_post"]
        }
      },
      {
        "id": "executor",
        "name": "Executor",
        "workspace": "~/.openclaw/workspace-executor",
        "sandbox": { "mode": "all", "scope": "agent" },
        "tools": {
          "allow": ["read", "write", "exec", "process"],
          "deny": ["browser", "sessions_spawn", "external_post"]
        }
      },
      {
        "id": "reviewer",
        "name": "Reviewer",
        "workspace": "~/.openclaw/workspace-reviewer",
        "sandbox": { "mode": "all", "scope": "agent" },
        "tools": {
          "allow": ["read", "browser", "exec_readonly"],
          "deny": ["write_code", "sessions_spawn", "external_post"]
        }
      },
      {
        "id": "pdf-generator",
        "name": "PDF Generator",
        "workspace": "~/.openclaw/workspace-report",
        "sandbox": { "mode": "all", "scope": "agent" },
        "tools": {
          "allow": ["read", "write", "pdf_tool"],
          "deny": ["browser", "sessions_spawn", "exec_unrestricted", "external_post"]
        }
      }
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/execution_request.schema.json",
  "title": "ExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "planner_id",
    "task",
    "workspace",
    "inputs",
    "success_criteria",
    "budget",
    "required_outputs"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique planner-issued execution request id."
    },
    "planner_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the planner run that owns this request."
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objective", "scope"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete execution goal assigned by the planner."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Allowed algorithmic, experimental, or visualisation scope."
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "read_paths", "write_path"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "read_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Planner-authorised read-only artifact paths."
        },
        "write_path": {
          "type": "string",
          "minLength": 1,
          "description": "Single directory where executor may create or modify files."
        }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Planner-authorised input artifacts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "kind"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["dataset", "code", "config", "notes", "spec", "previous_result", "other"]
          },
          "description": { "type": "string" },
          "read_only": { "type": "boolean", "const": true }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "check_type"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "check_type": {
            "type": "string",
            "enum": ["metric_threshold", "unit_test", "property_check", "visual_inspection", "manual_planner_review"]
          },
          "target": {},
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_wall_time_minutes"],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_wall_time_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "max_compute_notes": {
          "type": "string",
          "description": "Optional human-readable compute constraints."
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["results.json", "tests.json", "environment.json", "figures", "logs", "source_patch", "notes.md"]
      }
    },
    "tool_policy_ref": {
      "type": "string",
      "description": "Reference to the policy version the executor must obey."
    }
  }
}
